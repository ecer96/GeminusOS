#!/bin/sh
# GeminusOS: wpa_supplicant en wlan0 + vigilante DHCP, sin bloquear el arranque.
[ -e /sys/class/net/wlan0 ] || exit 0
/sbin/rfkill unblock all >/dev/null 2>&1
mkdir -p /var/run/wpa_supplicant
/sbin/ip link set wlan0 up >/dev/null 2>&1
i=0
while [ $i -lt 3 ]; do
    timeout 3 /sbin/wpa_cli -i wlan0 ping >/dev/null 2>&1 && break
    i=$((i+1)); sleep 1
done
if ! timeout 3 /sbin/wpa_cli -i wlan0 ping >/dev/null 2>&1; then
    timeout 5 /sbin/wpa_supplicant -B -i wlan0 -c /etc/wpa_supplicant.conf -D nl80211 >/dev/null 2>&1 || \
    timeout 5 /sbin/wpa_supplicant -B -i wlan0 -c /etc/wpa_supplicant.conf >/dev/null 2>&1
fi
# IP por DHCP (en segundo plano, nunca bloquea)
[ -x /usr/bin/wifi-dhcp-watch.sh ] && ( /usr/bin/wifi-dhcp-watch.sh >/dev/null 2>&1 & )
exit 0
